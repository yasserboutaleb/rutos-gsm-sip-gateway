#!/bin/sh
# rut360gw-config — generates the Asterisk configuration from /etc/config/rut360gw.
#
#   rut360gw-config apply      validates the configuration, then restarts the service (recommended)
#   rut360gw-config generate   writes /var/run/rut360gw/etc/*.conf (RAM); non-zero exit code if invalid
#   rut360gw-config migrate    converts the legacy vps section into the server section (ip mode)
#   rut360gw-config ports      shows the detected modem ports
#   rut360gw-config show       shows the effective configuration (secrets masked)
#
# Serial ports are found by the modem's USB interface number (rut360gw.modem.*),
# not by ttyUSBn name: the numbering can change after a USB re-enumeration.

# RutOS 7.14 installs packages under /usr/local (read-only root); / on the generic test bench
P=; [ -x /usr/local/usr/sbin/rut360gw-config ] && P=/usr/local
TPL=$P/usr/share/rut360gw/templates
OUT=/var/run/rut360gw/etc
RUNTIME_IND=/tmp/rut360gw/root/etc/asterisk/indications.conf

log() { logger -t rut360gw-config "$*"; echo "rut360gw-config: $*" >&2; }
get() { v=$(uci -q get "rut360gw.$1"); [ -n "$v" ] && echo "$v" || echo "$2"; }

# tty of USB interface <if> of the modem <vid:pid>
find_tty() {
	vid=${1%%:*}; pid=${1##*:}
	for dev in /sys/bus/usb/devices/*; do
		[ -f "$dev/idVendor" ] || continue
		[ "$(cat "$dev/idVendor")" = "$vid" ] && [ "$(cat "$dev/idProduct")" = "$pid" ] || continue
		for i in "$dev":*."$2"; do
			t=$(ls "$i" 2>/dev/null | grep -m1 '^ttyUSB')
			[ -n "$t" ] && { echo "/dev/$t"; return 0; }
		done
	done
	return 1
}

# addresses of a WireGuard tunnel created by an older version (interface wg_vps): peer and gateway
tun_peer() { s=$(uci -q show network | sed -n 's/^network\.\([^.=]*\)=wireguard_wg_vps$/\1/p' | head -1); [ -n "$s" ] && uci -q get "network.$s.allowed_ips" | awk '{print $1}' | cut -d/ -f1; }
tun_addr() { uci -q get network.wg_vps.addresses | awk '{print $1}' | cut -d/ -f1; }

# value safe for sed and for Asterisk files (no | ; \ or newline)
safe() { case "$1" in *'|'*|*';'*|*'\'*|*"
"*) return 1 ;; esac; return 0; }

load() {
	USB_ID=$(get modem.usb_id 2c7c:0306)
	AUDIO_IF=$(get modem.audio_if 1); DATA_IF=$(get modem.data_if 3)
	CLCC_POLL=$(get modem.clcc_poll 1000)
	COUNTRY=$(get main.country fr)
	# remote SIP server: section server; otherwise the legacy vps section (up to v0.1.1: trusted trunk
	# inside the package's WireGuard tunnel, whose addresses take precedence) = ip mode
	if uci -q get rut360gw.server >/dev/null; then
		SERVER_ON=$(get server.enabled 0); SERVER_MODE=$(get server.mode register)
		SERVER_HOST=$(get server.host ""); SERVER_PORT=$(get server.port 5060)
		SERVER_USER=$(get server.username ""); SERVER_PASSWORD=$(get server.password "")
		SERVER_EXT=$(get server.extension ""); LOCAL_ADDR=$(get server.local_address "")
		SERVER_CODEC=$(get server.codec ulaw)
	else
		SERVER_ON=$(get vps.enabled 1); SERVER_MODE=ip; SERVER_PORT=5060; SERVER_USER=; SERVER_PASSWORD=
		SERVER_HOST=$(tun_peer); LOCAL_ADDR=$(tun_addr)
		[ -n "$SERVER_HOST" ] || SERVER_HOST=$(get vps.peer_address "")
		[ -n "$LOCAL_ADDR" ] || LOCAL_ADDR=$(get vps.local_address "")
		SERVER_EXT=$(get vps.extension 102); SERVER_CODEC=$(get vps.codec ulaw)
	fi
	SIP_USER=$(get local.username rut360); SIP_PASSWORD=$(get local.password "")
	LOCAL_ON=0; [ -n "$SIP_PASSWORD" ] && LOCAL_ON=1
	GSM_IN=$(get features.gsm_in auto)
	LAN_SIP_LIMIT=$(get features.lan_sip_limit 20)
	# LAN subnet: the only source accepted for the LAN SIP client (ipaddr may be in CIDR notation)
	LAN_IP=$(uci -q get network.lan.ipaddr | awk '{print $1}'); LAN_MASK=$(uci -q get network.lan.netmask)
	case "$LAN_IP" in */*) LAN_NET=$LAN_IP ;; "") LAN_NET= ;; *) LAN_NET=$LAN_IP/${LAN_MASK:-255.255.255.0} ;; esac
	USSD_ENABLED=$(get features.ussd 1)
	# ringback tone of outgoing calls: local = generated by the gateway (over VoLTE the network sends
	# none); network = the network's own, with its announcements (2G/3G)
	RINGBACK=$(get features.ringback network)
	RTP_START=$(get features.rtp_start 10000); RTP_END=$(get features.rtp_end 10100)
}

validate() {
	ok=0
	ipv4() { echo "$1" | grep -q -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; }
	echo "$USB_ID" | grep -q -E '^[0-9a-f]{4}:[0-9a-f]{4}$' || { log "invalid modem.usb_id: $USB_ID"; ok=1; }
	for v in "$AUDIO_IF" "$DATA_IF" "$CLCC_POLL" "$RTP_START" "$RTP_END"; do
		echo "$v" | grep -q -E '^[0-9]+$' || { log "invalid numeric value: $v"; ok=1; }
	done
	[ "$AUDIO_IF" != 2 ] && [ "$DATA_IF" != 2 ] || { log "interface 2 is the AT port of RutOS gsmd: forbidden"; ok=1; }
	if [ "$SERVER_ON" = 1 ]; then
		echo "$SERVER_HOST" | grep -q -E '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || { log "invalid server.host: $SERVER_HOST"; ok=1; }
		echo "$SERVER_PORT" | grep -q -E '^[0-9]{1,5}$' || { log "invalid server.port"; ok=1; }
		echo "$SERVER_EXT" | grep -q -E '^[0-9A-Za-z_+-]+$' || { log "server.extension invalid or empty"; ok=1; }
		echo "$SERVER_CODEC" | grep -q -E '^(ulaw|alaw)(,(ulaw|alaw))?$' || { log "invalid server.codec (ulaw/alaw)"; ok=1; }
		case "$SERVER_MODE" in
			register)
				echo "$SERVER_USER" | grep -q -E '^[0-9A-Za-z_.+-]+$' || { log "server.username invalid or empty (register mode)"; ok=1; }
				[ -n "$SERVER_PASSWORD" ] && safe "$SERVER_PASSWORD" || { log "server.password empty or contains a forbidden character (| ; \\ or newline)"; ok=1; } ;;
			ip)
				# trusted peer: an IP address (not a name, so that the LAN anti-spoofing rule is exact)
				ipv4 "$SERVER_HOST" || { log "server.host: an IPv4 address is required in ip mode"; ok=1; }
				ipv4 "$LOCAL_ADDR" || { log "server.local_address: an IPv4 address is required in ip mode"; ok=1; } ;;
			*) log "invalid server.mode (register or ip)"; ok=1 ;;
		esac
	fi
	echo "$COUNTRY" | grep -q -E '^[a-z]{2}$' || { log "invalid main.country"; ok=1; }
	echo "$LAN_SIP_LIMIT" | grep -q -E '^[0-9]{1,4}$' || { log "invalid features.lan_sip_limit (0 to 9999 packets/s)"; ok=1; }
	[ -z "$LAN_NET" ] || echo "$LAN_NET" | grep -q -E '^([0-9]{1,3}.){3}[0-9]{1,3}/[0-9.]+$' || { log "unreadable LAN subnet ($LAN_NET): LAN SIP client access list omitted"; LAN_NET=; }
	case "$RINGBACK" in local) RINGBACK_OPT=r ;; network) RINGBACK_OPT= ;; *) log "invalid features.ringback (local or network)"; ok=1 ;; esac
	for v in "$SIP_USER" "$SIP_PASSWORD"; do safe "$v" || { log "forbidden character (| ; \\ or newline) in local.*"; ok=1; }; done
	# local.username names the PJSIP endpoint and AOR of the LAN client: a section name, not one of ours
	if [ "$LOCAL_ON" = 1 ]; then
		echo "$SIP_USER" | grep -q -E '^[A-Za-z0-9_.-]{1,32}$' || { log "invalid local.username (letters, digits, _ . -; 1 to 32)"; ok=1; }
		case "$SIP_USER" in global|transport-udp|local-auth|server|server-*) log "local.username: reserved name ($SIP_USER)"; ok=1 ;; esac
	fi
	# destinations of incoming GSM calls
	srv=; loc=
	[ "$SERVER_ON" = 1 ] && srv="PJSIP/$SERVER_EXT@server"
	[ "$LOCAL_ON" = 1 ] && loc="PJSIP/$SIP_USER"
	case "$GSM_IN" in
		auto) GSM_IN_DIAL=${srv:-$loc} ;;
		server) [ -n "$srv" ] || { log "features.gsm_in=server but the SIP server is disabled"; ok=1; }; GSM_IN_DIAL=$srv ;;
		local) [ -n "$loc" ] || { log "features.gsm_in=local but the LAN SIP client is disabled (local.password empty)"; ok=1; }; GSM_IN_DIAL=$loc ;;
		both) GSM_IN_DIAL=$srv${srv:+${loc:+&}}$loc
		      [ -n "$srv" ] && [ -n "$loc" ] || log "features.gsm_in=both: only one destination active ($GSM_IN_DIAL)" ;;
		*) log "invalid features.gsm_in (auto, server, local or both)"; ok=1 ;;
	esac
	[ -n "${GSM_IN_DIAL:-}" ] || log "no destination for incoming GSM calls: they will be refused (busy)"
	return $ok
}

sedq() { printf '%s' "$1" | sed 's/[&]/\\&/g'; } # value safe in a sed replacement (& = matched text)

render() { # $1 = template, $2 = destination
	sed -e "s|@USB_ID@|$USB_ID|g" -e "s|@AUDIO_IF@|$AUDIO_IF|g" -e "s|@DATA_IF@|$DATA_IF|g" \
	    -e "s|@AUDIO_TTY@|$AUDIO_TTY|g" -e "s|@DATA_TTY@|$DATA_TTY|g" -e "s|@CLCC_POLL@|$CLCC_POLL|g" \
	    -e "s|@COUNTRY@|$COUNTRY|g" -e "s|@LOCAL_ADDR@|${LOCAL_ADDR:-rut360gw}|g" \
	    -e "s|@SERVER_ON@|$SERVER_ON|g" -e "s|@SERVER_MODE@|$SERVER_MODE|g" -e "s|@SERVER_HOST@|$SERVER_HOST|g" \
	    -e "s|@SERVER_PORT@|$SERVER_PORT|g" -e "s|@SERVER_EXT@|$SERVER_EXT|g" -e "s|@SERVER_CODEC@|$SERVER_CODEC|g" \
	    -e "s|@SERVER_USER@|$SERVER_USER|g" -e "s|@SERVER_PASSWORD@|$(sedq "$SERVER_PASSWORD")|g" \
	    -e "s|@LAN_NET@|$LAN_NET|g" -e "s|@LOCAL_ON@|$LOCAL_ON|g" -e "s|@GSM_IN_DIAL@|$(sedq "$GSM_IN_DIAL")|g" \
	    -e "s|@USSD_ENABLED@|$USSD_ENABLED|g" -e "s|@RINGBACK_OPT@|$RINGBACK_OPT|g" \
	    -e "s|@RTP_START@|$RTP_START|g" -e "s|@RTP_END@|$RTP_END|g" \
	    -e "s|@SBIN@|$P/usr/sbin|g" -e "s|@SIP_USER@|$SIP_USER|g" -e "s|@SIP_PASSWORD@|$(sedq "$SIP_PASSWORD")|g" "$1" > "$2"
}

generate() {
	load
	validate || { log "invalid configuration: nothing generated"; return 1; }
	# RUT360GW_AUDIO_TTY / RUT360GW_DATA_TTY: reserved for the test bench (no USB modem); never set on the router
	AUDIO_TTY=${RUT360GW_AUDIO_TTY:-$(find_tty "$USB_ID" "$AUDIO_IF")} || { log "modem $USB_ID: interface $AUDIO_IF not found"; return 1; }
	DATA_TTY=${RUT360GW_DATA_TTY:-$(find_tty "$USB_ID" "$DATA_IF")} || { log "modem $USB_ID: interface $DATA_IF not found"; return 1; }
	[ -n "$AUDIO_TTY" ] && [ -n "$DATA_TTY" ] || { log "modem ports not found"; return 1; }
	umask 077
	rm -rf "$OUT.new"; mkdir -p "$OUT.new"
	for f in asterisk extensions logger modules quectel rtp; do render "$TPL/$f.conf" "$OUT.new/$f.conf"; done
	# Files the loaded modules read at startup: when they were missing, Asterisk logged 7
	# "Unable to load config file" errors at every start. Default values, CDR/CEL disabled.
	for f in ccss features udptl; do printf '[general]\n' > "$OUT.new/$f.conf"; done
	for f in cdr cel; do printf '[general]\nenable = no\n' > "$OUT.new/$f.conf"; done
	printf '; no named access control list\n' > "$OUT.new/acl.conf"
	printf '[startup]\n' > "$OUT.new/pjproject.conf"
	# PJSIP: remove the disabled blocks
	drop=""
	[ -n "$SIP_PASSWORD" ] || drop="$drop local"
	[ -n "$LAN_NET" ] || drop="$drop lanacl"
	if [ "$SERVER_ON" = 1 ]; then
		[ "$SERVER_MODE" = register ] && drop="$drop ip" || drop="$drop register"
	else
		drop="$drop server register ip"
	fi
	render "$TPL/pjsip.conf" "$OUT.new/pjsip.conf.tmp"
	for b in $drop; do sed -i "/^;#BEGIN $b/,/^;#END $b/d" "$OUT.new/pjsip.conf.tmp"; done
	mv "$OUT.new/pjsip.conf.tmp" "$OUT.new/pjsip.conf"
	# Tones: Asterisk's countries (if the runtime is present) + rut360gw's own country sections
	render "$TPL/indications.conf" "$OUT.new/indications.conf"
	if [ -f "$RUNTIME_IND" ]; then
		awk '/^\[general\]/{skip=1; next} /^\[/{skip=0} !skip' "$RUNTIME_IND" | grep -v '^\[fr\]' > "$OUT.new/ind.extra"
		# keep only the Asterisk countries missing from our template
		awk 'NR==FNR { if ($0 ~ /^\[/) have[$0]=1; next } /^\[/ { keep = !($0 in have) } keep' \
			"$OUT.new/indications.conf" "$OUT.new/ind.extra" >> "$OUT.new/indications.conf"
		rm -f "$OUT.new/ind.extra"
	fi
	grep -q "^\[$COUNTRY\]" "$OUT.new/indications.conf" || { log "country $COUNTRY missing from the tone definitions"; rm -rf "$OUT.new"; return 1; }
	if grep -q '@[A-Z_]*@' "$OUT.new"/*.conf; then
		log "unreplaced variable: $(grep -l '@[A-Z_]*@' "$OUT.new"/*.conf | tr '\n' ' ')"; rm -rf "$OUT.new"; return 1
	fi
	rm -rf "$OUT"; mv "$OUT.new" "$OUT"
	log "configuration generated (audio=$AUDIO_TTY data=$DATA_TTY server=$([ "$SERVER_ON" = 1 ] && echo "$SERVER_MODE" || echo 0) local=$LOCAL_ON gsm_in=${GSM_IN_DIAL:-none} country=$COUNTRY)"
}

# Migration of settings up to v0.1.1: section vps (trusted trunk inside the WireGuard tunnel
# the package used to create) -> section server in ip mode, with the tunnel addresses if it exists
# (they took precedence). The vps and wg sections stay in place: a downgrade to v0.1.1 finds them.
migrate() {
	uci -q get rut360gw.server >/dev/null && return 0
	uci -q get rut360gw.vps >/dev/null || return 0
	peer=$(tun_peer); addr=$(tun_addr)
	[ -n "$peer" ] || peer=$(get vps.peer_address "")
	[ -n "$addr" ] || addr=$(get vps.local_address "")
	uci set rut360gw.server=server
	uci set rut360gw.server.enabled="$(get vps.enabled 1)"
	uci set rut360gw.server.mode=ip
	uci set rut360gw.server.host="$peer"
	uci set rut360gw.server.port=5060
	uci set rut360gw.server.extension="$(get vps.extension "")"
	uci set rut360gw.server.local_address="$addr"
	uci set rut360gw.server.codec="$(get vps.codec ulaw)"
	uci commit rut360gw
	log "settings migrated from the vps section: SIP server in ip mode ($peer, extension $(get vps.extension ''), gateway $addr)"
}

case "${1:-}" in
	generate) generate ;;
	migrate) migrate ;;
	apply)
		# recommended after a change: `uci commit rut360gw` then `rut360gw-config apply`
		# (validates first; does not use reload_config, which also reloads the RutOS network)
		# validate first (uci get also reads uncommitted changes); commit only if valid
		generate || { log "configuration refused: nothing committed (uci changes rut360gw / uci revert rut360gw), service unchanged"; exit 1; }
		[ -n "$(uci changes rut360gw)" ] && uci commit rut360gw
		/etc/init.d/rut360gw restart
		;;
	ports) load; echo "audio (if $AUDIO_IF) : $(find_tty "$USB_ID" "$AUDIO_IF" || echo 'not found')"; echo "data  (if $DATA_IF) : $(find_tty "$USB_ID" "$DATA_IF" || echo 'not found')" ;;
	show) uci show rut360gw | sed -E "s/(password=).*/\1'<hidden>'/" ;;
	*) echo "usage: $0 apply|generate|migrate|ports|show" >&2; exit 2 ;;
esac
