#!/usr/bin/lua
--[[
rut360gw-sms — SMS <-> SIP bridge of the RUT360 (RutOS remains the sole owner of SMS).

  rut360gw-sms send <number> <text_base64>
      Called by Asterisk (dialplan [sms-out]) when Linphone sends a MESSAGE to a phone number.
      The text arrives base64-encoded (no shell injection possible), the number is validated.
      Sent with `gsmctl -S -s`. Exit code 0 = sent.

  rut360gw-sms daemon
      Watches received SMS (`gsmctl -S -l all`, every 10 s). Each new and complete SMS is
      handed to Asterisk (context [sms-to-sip]), which sends it as a SIP MESSAGE to the
      remote SIP server (extension server.extension), or to the LAN SIP client.
      SIM purge (features.sms_purge, default 1): an SMS RELAYED SUCCESSFULLY is deleted from
      the SIM after features.sms_purge_delay seconds (default 300); this delay gives the native
      RutOS e-mail forwarding (SMS Gateway > SMS Forwarding, triggered on reception) time to
      run. Never purged automatically: SMS already present at first start, SMS that could not
      be relayed, incomplete SMS.
      Record of already relayed SMS: /etc/rut360gw/sms.seen (one line per SMS, 500 max;
      suffix "+" = relayed successfully, hence purgeable). Written only when an SMS arrives.
      On the very first start, SMS already present are marked as seen (no burst).

  rut360gw-sms sms-list | sms-delete <index|all>
      For the web page (rpcd module): JSON list of the SMS on the SIM (+ usage, RutOS e-mail
      forwarding); deletion of one SMS or of all of them.

  rut360gw-sms ussd-web <text> | ussd-cancel | ussd-clear | ussd-history
      For the web page: interactive USSD session. `ussd-web` sends a code (*...#) or a menu
      answer (digits) and waits for the network reply (run in the background by the rpcd
      module); `ussd-history` returns the JSON history (RAM, 40 entries max).

  rut360gw-sms ussd <code>
      Called by Asterisk when Linphone dials *code (context [from-server]): USSD request through
      the gsmd ubus API (set_ussd), reply read from /tmp/ussd_1-1_1 (written by gsmd), sent back
      to Linphone as a SIP MESSAGE. One request at a time; refused during a GSM call, because USSD
      may force a 2G/3G fallback (CSFB) that cuts mobile data for ~45 s.
      /etc/rut360gw/ussd.dryrun present = dry run: its content is used as the reply.

  rut360gw-sms selftest
      Offline self-test (base64, parsing, escaping).

Lua 5.1 + standard library only (RutOS has no base64 binary).
]]

local SEEN_FILE = os.getenv("RUT360GW_SMS_SEEN") or "/etc/rut360gw/sms.seen"
local GSMCTL = os.getenv("RUT360GW_GSMCTL") or "gsmctl"
-- RutOS 7.14 installs packages under /usr/local (read-only root); / for the generic test bench
local PFX = ""
do local f = io.open("/usr/local/usr/sbin/rut360gw-cli", "r"); if f then f:close(); PFX = "/usr/local" end end
local AST = PFX .. "/usr/sbin/rut360gw-cli "
local POLL_S, STATUS_WAIT_S, MAX_TRIES, SEEN_MAX = 10, 15, 5, 500

-- ---------------------------------------------------------------- utilities
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function b64enc(s)
	return ((s:gsub(".", function(c)
		local b, r = c:byte(), ""
		for i = 8, 1, -1 do r = r .. (b % 2 ^ i - b % 2 ^ (i - 1) > 0 and "1" or "0") end
		return r
	end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
		if #x < 6 then return "" end
		local c = 0
		for i = 1, 6 do c = c + (x:sub(i, i) == "1" and 2 ^ (6 - i) or 0) end
		return B64:sub(c + 1, c + 1)
	end) .. ({ "", "==", "=" })[#s % 3 + 1])
end

local function b64dec(s)
	s = s:gsub("[^" .. B64 .. "=]", "")
	return (s:gsub(".", function(x)
		if x == "=" then return "" end
		local r, f = "", (B64:find(x, 1, true) - 1)
		for i = 6, 1, -1 do r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0") end
		return r
	end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
		if #x ~= 8 then return "" end
		local c = 0
		for i = 1, 8 do c = c + (x:sub(i, i) == "1" and 2 ^ (8 - i) or 0) end
		return string.char(c)
	end))
end

local function shquote(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end

local function run(cmd)
	local p = io.popen(cmd .. " 2>&1")
	local out = p:read("*a") or ""
	p:close()
	return out
end

local function log(msg) os.execute("logger -t rut360gw-sms " .. shquote(msg)) end

local function uci_get(path, default)
	-- stderr discarded (otherwise an error message would become the value): no run(), which adds 2>&1
	local p = io.popen("uci -q get " .. shquote(path) .. " 2>/dev/null")
	local v = (p:read("*a") or ""):gsub("%s+$", "")
	p:close()
	if v == "" then return default end
	return v
end

-- Minimal JSON (output for the rpcd module / the web page)
local function jstr(s)
	s = tostring(s or "")
	s = s:gsub('[%c"\\]', function(c)
		if c == '"' then return '\\"' elseif c == "\\" then return "\\\\" elseif c == "\n" then return "\\n"
		elseif c == "\r" then return "\\r" elseif c == "\t" then return "\\t" end
		return string.format("\\u%04x", c:byte())
	end)
	return '"' .. s .. '"'
end
local function json(v)
	local t = type(v)
	if t == "table" then
		if v[1] ~= nil or next(v) == nil and getmetatable(v) == "array" then
			local out = {}
			for _, x in ipairs(v) do out[#out + 1] = json(x) end
			return "[" .. table.concat(out, ",") .. "]"
		end
		local keys, out = {}, {}
		for k in pairs(v) do keys[#keys + 1] = k end
		table.sort(keys)
		for _, k in ipairs(keys) do out[#out + 1] = jstr(k) .. ":" .. json(v[k]) end
		return "{" .. table.concat(out, ",") .. "}"
	elseif t == "boolean" then return v and "true" or "false"
	elseif t == "number" then return string.format("%.0f", v)   -- %d is capped at 2^31 on RutOS ("double int32" Lua)
	end
	return jstr(v)
end
local function array(t) return setmetatable(t or {}, { __metatable = "array" }) end

-- 32-bit FNV-1a (fingerprint of already relayed SMS): xor of the low byte then
-- multiplication modulo 2^32 (Lua 5.1 = doubles, exact as long as < 2^53)
local function fnv1a(s)
	local h = 2166136261
	for i = 1, #s do
		local b, x, bit, res = s:byte(i), h % 256, 1, 0
		for _ = 1, 8 do
			if (x % 2) ~= (b % 2) then res = res + bit end
			x, b, bit = math.floor(x / 2), math.floor(b / 2), bit * 2
		end
		h = (h - h % 256 + res)
		-- h * 16777619 mod 2^32, with 16777619 = 2^24 + 403: each term stays exact (< 2^53)
		h = ((h % 256) * 16777216 + h * 403) % 4294967296
	end
	-- RutOS Lua = "double int32": %x rejects > 2^31, so print two 16-bit halves
	return string.format("%04x%04x", math.floor(h / 65536), h % 65536)
end

local function valid_number(n) return type(n) == "string" and n:match("^%+?%d+$") and #n >= 3 and #n <= 20 end

-- Parsing of `gsmctl -S -l all`: "Key:\tvalue" blocks separated by an empty line;
-- the text (last field) may span several lines.
local function parse_list(out)
	local msgs, cur, in_text = {}, nil, false
	for line in (out .. "\n"):gmatch("([^\n]*)\n") do
		local k, v = line:match("^(%a[%a ]-):%s*(.*)$")
		if k == "Index" and v:match("^%d+$") then
			cur = { Index = tonumber(v), Text = "" }
			msgs[#msgs + 1] = cur
			in_text = false
		elseif cur and k == "Text" and not in_text then
			cur.Text, in_text = v, true
		elseif cur and in_text then
			if line == "" then in_text = false else cur.Text = cur.Text .. "\n" .. line end
		elseif cur and k then
			cur[k] = v
		end
	end
	for _, m in ipairs(msgs) do
		m.Text = (m.Text or ""):gsub("%s+$", "")
		m.key = fnv1a((m.Date or "") .. "|" .. (m.Sender or "") .. "|" .. m.Text)
	end
	return msgs
end

-- ---------------------------------------------------------------- sending (SIP -> SMS)
-- The log lines of this file are parsed by the web page (app.js, toEvent): change both together.
local function cmd_send(num, b64)
	if not valid_number(num) then log("send refused: invalid number"); return 2 end
	local text = b64dec(b64 or "")
	if text == "" then log("send refused: empty text"); return 2 end
	local out = run(GSMCTL .. " -S -s " .. shquote(num .. " " .. text))
	if out:match("SMS sent") then
		log(string.format("SMS sent to %s (%d chars)", num:sub(1, 4) .. "...", #text))
		return 0
	end
	log("SMS send failed: " .. out:gsub("%s+", " "))
	return 1
end

-- ---------------------------------------------------------------- reception (SMS -> SIP)
-- seen[key] = true (seen); relayed[key] = true (relayed successfully: line "key+" in the file)
local function load_seen()
	local seen, order, relayed = {}, {}, {}
	local f = io.open(SEEN_FILE, "r")
	if not f then return nil, order, relayed end
	for l in f:lines() do
		local k, plus = l:match("^(%x+)(%+?)$")
		if k then seen[k] = true; order[#order + 1] = k; if plus == "+" then relayed[k] = true end end
	end
	f:close()
	return seen, order, relayed
end

local function save_seen(order, relayed)
	while #order > SEEN_MAX do table.remove(order, 1) end
	local lines = {}
	for i, k in ipairs(order) do lines[i] = k .. ((relayed and relayed[k]) and "+" or "") end
	local tmp = SEEN_FILE .. ".tmp"
	local f = assert(io.open(tmp, "w"))
	f:write(table.concat(lines, "\n"), "\n")
	f:close()
	os.rename(tmp, SEEN_FILE)
end

-- Purge: an SMS is deleted from the SIM if it was relayed successfully, is complete and was
-- relayed at least `delay` seconds ago (relayed_at = os.time() of the success, or of the
-- daemon start for those relayed before a restart).
local function purge_candidates(msgs, relayed, relayed_at, now, delay)
	local out = {}
	for _, m in ipairs(msgs) do
		if relayed[m.key] and (m.Missing == nil or m.Missing == "0") and relayed_at[m.key]
			and now - relayed_at[m.key] >= delay then
			out[#out + 1] = m
		end
	end
	return out
end

-- Sends a text as a SIP MESSAGE (remote server, otherwise LAN client) through the [sms-to-sip] context.
local function forward_text(body, sender, tag)
	local id = tostring(os.time()) .. "x" .. (tag or fnv1a(body))
	sender = (sender or "unknown"):gsub("[^%w%+]", "")
	if sender == "" then sender = "unknown" end
	run(AST .. shquote("database put rut360sms " .. id .. "_b64 " .. b64enc(body)))
	run(AST .. shquote("database put rut360sms " .. id .. "_from " .. sender))
	run(AST .. shquote("channel originate Local/" .. id .. "@sms-to-sip application Wait 1"))
	local status = ""
	for _ = 1, STATUS_WAIT_S do
		os.execute("sleep 1")
		status = run(AST .. shquote("database get rut360sms " .. id .. "_status")):match("Value:%s*(%S+)") or ""
		if status ~= "" then break end
	end
	for _, k in ipairs({ "_b64", "_from", "_status" }) do run(AST .. shquote("database del rut360sms " .. id .. k)) end
	return status == "SUCCESS", status
end

local function forward(m)
	local body = string.format("SMS from %s (%s):\n%s", m.Sender or "?", m.Date or "?", m.Text)
	return forward_text(body, m.Sender, m.key)
end

-- ---------------------------------------------------------------- USSD (Linphone *code -> network -> MESSAGE)
local USSD_FILE = os.getenv("RUT360GW_USSD_FILE") or "/tmp/ussd_1-1_1"   -- written by gsmd on +CUSD
local USSD_DRYRUN = os.getenv("RUT360GW_USSD_DRYRUN") or "/etc/rut360gw/ussd.dryrun"                        -- present = dry run (no radio request)
local USSD_LOCK = "/tmp/rut360gw-ussd.lock"
local USSD_WAIT_S = 45
local CUSD_STATUS = {
	["0"] = "", ["1"] = "(menu: reply from the USSD tab of the router web page)", ["2"] = "(session ended by the network)",
	["3"] = "(answered by another client)", ["4"] = "operation not supported by the operator",
	["5"] = "network timeout (USSD not supported?)",
}

local function valid_ussd(c) return type(c) == "string" and c:match("^[%*#][%d%*#]*$") and #c >= 2 and #c <= 64 end

-- Hexadecimal UCS-2 decoding (DCS 72) -> UTF-8
local function ucs2hex_to_utf8(h)
	if not h:match("^%x+$") or #h % 4 ~= 0 then return nil end
	local out = {}
	for i = 1, #h, 4 do
		local c = tonumber(h:sub(i, i + 3), 16)
		if c < 0x80 then out[#out + 1] = string.char(c)
		elseif c < 0x800 then out[#out + 1] = string.char(0xC0 + math.floor(c / 64), 0x80 + c % 64)
		else out[#out + 1] = string.char(0xE0 + math.floor(c / 4096), 0x80 + math.floor(c / 64) % 64, 0x80 + c % 64) end
	end
	return table.concat(out)
end

-- gsmd line: "YYYY-MM-DD hh:mm:ss <status>,<"text">,<dcs>"
local function parse_cusd(line)
	local st, rest = (line or ""):match("^%S+ %S+ (%d+),(.*)$")
	if not st then return nil end
	local text, dcs = rest:match('^"?(.-)"?,(%d*)%s*$')
	text = text or rest
	if dcs == "72" then text = ucs2hex_to_utf8(text) or text end
	return st, text
end

-- USSD history in RAM (web page): "ts \t direction \t status \t source \t text_base64", 40 lines max
local USSD_HIST = os.getenv("RUT360GW_USSD_HIST") or "/tmp/rut360gw-ussd.hist"
local USSD_HIST_MAX = 40
local function hist_read()
	local out = {}
	local f = io.open(USSD_HIST, "r")
	if not f then return out end
	for l in f:lines() do
		local ts, dir, st, src, b = l:match("^(%d+)\t(%a+)\t(%d*)\t(%a+)\t(.*)$")
		if ts then out[#out + 1] = { ts = tonumber(ts), dir = dir, status = st, source = src, text = b64dec(b) } end
	end
	f:close()
	return out
end
local function hist_add(dir, st, src, text)
	local lines = {}
	local f = io.open(USSD_HIST, "r")
	if f then for l in f:lines() do lines[#lines + 1] = l end; f:close() end
	lines[#lines + 1] = table.concat({ os.time(), dir, st or "", src, b64enc(text or "") }, "\t")
	while #lines > USSD_HIST_MAX do table.remove(lines, 1) end
	local w = assert(io.open(USSD_HIST .. ".tmp", "w"))
	w:write(table.concat(lines, "\n"), "\n"); w:close()
	os.rename(USSD_HIST .. ".tmp", USSD_HIST)
end
-- session open: last network reply = "1" (action expected) less than 3 min ago
local function ussd_session_open(h)
	for i = #h, 1, -1 do
		if h[i].dir == "in" then return h[i].status == "1" and os.time() - h[i].ts < 180 end
	end
	return false
end

-- Lock (one USSD request at a time); nil, reason if refused
local function ussd_lock()
	if os.execute("mkdir " .. USSD_LOCK .. " 2>/dev/null") ~= 0 then
		local age = tonumber(run("echo $(( $(date +%s) - $(date -r " .. USSD_LOCK .. " +%s) ))")) or 0
		if age < 120 then return nil, "another USSD request is in progress" end
	end
	-- never during a GSM call: USSD may cause a 2G/3G fallback (CSFB) and drop the call
	if run(AST .. shquote("core show channels concise")):match("Quectel/") then
		os.execute("rmdir " .. USSD_LOCK .. " 2>/dev/null")
		return nil, "refused during a GSM call"
	end
	return true
end
local function ussd_unlock() os.execute("rmdir " .. USSD_LOCK .. " 2>/dev/null") end

-- Sends a code or a menu answer; returns the CUSD status (or nil) and the text.
-- Dry run: /etc/rut360gw/ussd.dryrun ("1|text" simulates a menu waiting for an answer).
local function ussd_request(req)
	local f = io.open(USSD_DRYRUN, "r")
	if f then
		local c = f:read("*a"):gsub("%s+$", ""); f:close()
		log("USSD " .. req .. ": dry run (no radio request)")
		local st, t = c:match("^(%d)|(.*)$")
		return st or "0", t or c
	end
	os.remove(USSD_FILE)
	log("USSD " .. req .. ": sent to the network")
	run("ubus -t 10 call gsm.modem0 set_ussd " .. shquote('{"mode":"enable","request":"' .. req .. '","coding_scheme":15}'))
	for _ = 1, USSD_WAIT_S do
		os.execute("sleep 1")
		local fh = io.open(USSD_FILE, "r")
		if fh then local st, text = parse_cusd(fh:read("*l")); fh:close(); if st then return st, text end end
	end
	return nil, ""
end

local function cmd_ussd(code)
	if not valid_ussd(code) then log("USSD refused: invalid code"); return 2 end
	if not code:match("#$") then code = code .. "#" end
	local okl, why = ussd_lock()
	if not okl then
		forward_text("USSD " .. code .. ": refused (" .. why .. ")", "ussd")
		return 1
	end
	local function done(rc) ussd_unlock(); return rc end
	hist_add("out", "", "linphone", code)
	local st, text = ussd_request(code)
	hist_add("in", st or "", "linphone", st and text or "no answer from the network")
	local body
	if not st then
		body = "USSD " .. code .. ": no answer from the network within " .. USSD_WAIT_S .. " s"
	else
		local note = CUSD_STATUS[st] or ("(status " .. st .. ")")
		body = "USSD " .. code .. ":\n" .. ((text and text ~= "") and text or "") .. ((note ~= "") and ("\n" .. note) or "")
	end
	local ok = forward_text(body, "ussd")
	log("USSD " .. code .. ": answer " .. (st or "none") .. ", relayed to SIP = " .. tostring(ok))
	return done(ok and 0 or 1)
end

-- Web page: code (*...#) or menu answer (digits, * and #); run in the background by rpcd.
local function valid_ussd_web(t) return type(t) == "string" and t:match("^[%d%*#]+$") and #t >= 1 and #t <= 64 end
local function cmd_ussd_web(req)
	if uci_get("rut360gw.features.ussd", "1") ~= "1" then hist_add("in", "", "web", "USSD is disabled in Settings"); return 1 end
	if not valid_ussd_web(req) then hist_add("in", "", "web", "invalid USSD input"); return 2 end
	if req:match("^[%*#]") and not req:match("#$") then req = req .. "#" end
	local okl, why = ussd_lock()
	if not okl then hist_add("in", "", "web", "refused: " .. why); return 1 end
	hist_add("out", "", "web", req)
	local st, text = ussd_request(req)
	local CUSD_EN = { ["2"] = "session ended by the network", ["3"] = "answered by another client",
		["4"] = "operation not supported by the operator", ["5"] = "network timeout (USSD not supported?)" }
	if not st then text = "no answer from the network within " .. USSD_WAIT_S .. " s"
	elseif st ~= "0" and st ~= "1" and (text or "") == "" then text = CUSD_EN[st] or ("status " .. st) end
	hist_add("in", st or "", "web", text)
	log("USSD web " .. req .. ": answer " .. (st or "none"))
	ussd_unlock()
	return 0
end

local function cmd_ussd_cancel()
	if os.execute("test -e " .. shquote(USSD_DRYRUN)) ~= 0 then
		run("ubus -t 10 call gsm.modem0 set_ussd " .. shquote('{"mode":"cancel","request":"","coding_scheme":15}'))
	end
	hist_add("in", "2", "web", "session closed")
	print(json({ ok = true }))
	return 0
end

-- "Clear session" button of the web page: closes the USSD session on the network side and
-- erases the whole history (RAM), including the exchanges made from Linphone
local function cmd_ussd_clear()
	if os.execute("test -e " .. shquote(USSD_DRYRUN)) ~= 0 then
		run("ubus -t 10 call gsm.modem0 set_ussd " .. shquote('{"mode":"cancel","request":"","coding_scheme":15}'))
	end
	os.remove(USSD_HIST)
	print(json({ ok = true }))
	return 0
end

local function cmd_ussd_history()
	local h = hist_read()
	local entries = array()
	for i, e in ipairs(h) do entries[i] = e end
	local pending = os.execute("test -d " .. USSD_LOCK) == 0
	print(json({ ok = true, entries = entries, pending = pending, session_open = ussd_session_open(h),
		enabled = uci_get("rut360gw.features.ussd", "1") == "1" }))
	return 0
end

local function cmd_daemon()
	local purge = uci_get("rut360gw.features.sms_purge", "1") == "1"
	local delay = tonumber(uci_get("rut360gw.features.sms_purge_delay", "300")) or 300
	if delay < 60 then delay = 60 end
	log("SMS -> SIP bridge started (SIM purge: " .. (purge and ("after " .. delay .. " s") or "off") .. ")")
	local seen, order, relayed = load_seen()
	local tries, relayed_at, start = {}, {}, os.time()
	for k in pairs(relayed) do relayed_at[k] = start end
	if not seen then
		seen = {}
		for _, m in ipairs(parse_list(run(GSMCTL .. " -S -l all"))) do
			if not seen[m.key] then seen[m.key] = true; order[#order + 1] = m.key end
		end
		save_seen(order, relayed)
		log(string.format("first start: %d SMS already on the SIM marked as seen (never purged)", #order))
	end
	while true do
		local ast_up = run(AST .. shquote("core show uptime")):match("System uptime") ~= nil
		if ast_up then
			local msgs = parse_list(run(GSMCTL .. " -S -l all"))
			for _, m in ipairs(msgs) do
				if not seen[m.key] and (m.Missing == nil or m.Missing == "0") then
					local ok, st = forward(m)
					tries[m.key] = (tries[m.key] or 0) + 1
					if ok or tries[m.key] >= MAX_TRIES then
						seen[m.key] = true; order[#order + 1] = m.key
						if ok then relayed[m.key] = true; relayed_at[m.key] = os.time() end
						save_seen(order, relayed)
						log(ok and ("SMS index " .. m.Index .. " relayed to SIP")
							or ("SMS index " .. m.Index .. " given up after " .. MAX_TRIES .. " tries (" .. st .. "): kept on the SIM"))
					end
				end
			end
			if purge then
				for _, m in ipairs(purge_candidates(msgs, relayed, relayed_at, os.time(), delay)) do
					local out = run(GSMCTL .. " -S -d " .. tonumber(m.Index))
					relayed_at[m.key] = nil   -- a single attempt per daemon start
					log("SMS index " .. m.Index .. " removed from the SIM (relayed): " .. out:gsub("%s+", " "))
				end
			end
		end
		os.execute("sleep " .. POLL_S)
	end
end

-- ---------------------------------------------------------------- web page: SMS on the SIM
local function cmd_sms_list()
	local msgs = parse_list(run(GSMCTL .. " -S -l all"))
	local seen, _, relayed = load_seen()
	seen = seen or {}
	local tot = run(GSMCTL .. " -S -t")
	local list = array()
	for _, m in ipairs(msgs) do
		list[#list + 1] = {
			index = m.Index, date = m.Date or "", sender = m.Sender or "", status = m.Status or "",
			text = m.Text, complete = (m.Missing == nil or m.Missing == "0"),
			relayed = relayed[m.key] == true, seen = seen[m.key] == true,
		}
	end
	-- native RutOS e-mail forwarding: section "to_smtp" (type fwd)
	local smtp = "sms_gateway.to_smtp"
	print(json({
		ok = true, messages = list,
		used = tonumber(tot:match("Used:%s*(%d+)")) or #msgs, total = tonumber(tot:match("Total:%s*(%d+)")) or 0,
		purge = uci_get("rut360gw.features.sms_purge", "1") == "1",
		purge_delay = tonumber(uci_get("rut360gw.features.sms_purge_delay", "300")) or 300,
		email_forward = uci_get(smtp .. ".enabled", "0") == "1",
		email_delete = uci_get(smtp .. ".delete_sms", "0") == "1",
	}))
	return 0
end

local function cmd_sms_delete(what)
	local idx = {}
	if what == "all" then
		for _, m in ipairs(parse_list(run(GSMCTL .. " -S -l all"))) do idx[#idx + 1] = m.Index end
	elseif what and what:match("^%d+$") and #what <= 4 then
		idx[1] = tonumber(what)
	else
		print(json({ ok = false, error = "invalid SMS index" })); return 0
	end
	for _, i in ipairs(idx) do run(GSMCTL .. " -S -d " .. i) end
	-- result checked by reading the SIM again (the gsmctl output wording is not documented)
	local left = {}
	for _, m in ipairs(parse_list(run(GSMCTL .. " -S -l all"))) do left[m.Index] = true end
	local done = 0
	for _, i in ipairs(idx) do if not left[i] then done = done + 1 end end
	log(string.format("web page: %d/%d SMS deleted from the SIM (%s)", done, #idx, what))
	if done < #idx then print(json({ ok = false, error = string.format("%d of %d SMS could not be deleted", #idx - done, #idx) })); return 0 end
	print(json({ ok = true, deleted = done }))
	return 0
end

-- ---------------------------------------------------------------- offline self-test
-- UTF-8 test strings are written with decimal escapes (\195\169 = e acute, \226\130\172 = euro sign,
-- \240\159\152\128 = emoji, \226\156\147 = check mark) so that the source stays ASCII.
-- The final result line ("Result: OK") is grepped by
-- ci/run-local.sh: change both together.
local function cmd_selftest()
	local fails = 0
	local function check(name, cond) print((cond and "PASS  " or "FAIL  ") .. name); if not cond then fails = fails + 1 end end
	for _, s in ipairs({ "", "a", "ab", "abc", "\195\169\226\130\172\240\159\152\128 \226\156\147", "line1\nline2", string.rep("x", 300) }) do
		check("base64 round trip (" .. #s .. " bytes)", b64dec(b64enc(s)) == s)
	end
	check("base64 compliant with RFC 4648", b64enc("\195\169\226\130\172\240\159\152\128") == "w6nigqzwn5iA")
	check("shquote neutralises the apostrophe", shquote("a'b; rm -rf /") == [['a'\''b; rm -rf /']])
	check("number +33... accepted", valid_number("+33612345678"))
	check("number with ; refused", not valid_number("0612;reboot"))
	check("empty number refused", not valid_number(""))
	local sample = "Index:\t\t3\nDate:\t\tWed Nov 11 11:17:53 2026\nSender:\t\t+33600000000\nStatus:\t\tread\nMissing:\t0\nText:\t\tHello\non two lines\n\nIndex:\t\t0\nDate:\t\tThu Jan  1 00:00:00 1970\nSender:\t\t2051\nStatus:\t\tread\nMissing:\t0\nText:\t\tOperator info\n\n"
	local l = parse_list(sample)
	check("parsing: 2 messages", #l == 2)
	check("parsing: multi-line text", l[1] and l[1].Text == "Hello\non two lines")
	check("parsing: sender", l[2] and l[2].Sender == "2051")
	check("stable fingerprint", l[1] and l[1].key == parse_list(sample)[1].key)
	check("distinct fingerprints", l[1] and l[2] and l[1].key ~= l[2].key)
	-- USSD
	check("USSD *222 accepted", valid_ussd("*222"))
	check("USSD *111*1234# accepted", valid_ussd("*111*1234#"))
	check("USSD with ; refused", not valid_ussd("*222;reboot"))
	check("USSD without * or # refused", not valid_ussd("222"))
	local s1, t1 = parse_cusd("2026-11-11 12:24:58 5,,15")
	check("CUSD status 5 without text", s1 == "5" and t1 == "")
	local s2, t2 = parse_cusd('2026-11-11 12:30:00 0,"Balance: 12,50 EUR",15')
	check("CUSD text with a comma", s2 == "0" and t2 == "Balance: 12,50 EUR")
	local _, t3 = parse_cusd('2026-11-11 12:30:00 1,"00E9007400E9",72')
	check("CUSD UCS-2 (DCS 72) decoded", t3 == "\195\169t\195\169")
	-- JSON (web page)
	check("JSON: quote/newline escaping", json({ a = 'x"y\n' }) == '{"a":"x\\"y\\n"}')
	check("JSON: control character", json("a\1b") == '"a\\u0001b"')
	check("JSON: empty array = []", json(array()) == "[]")
	check("JSON: large integer without exponent notation", json(1794409860) == "1794409860")
	check("JSON: UTF-8 unchanged", json("\195\169\226\130\172") == '"\195\169\226\130\172"')
	-- SIM purge
	local msgs = { { key = "a", Index = 1, Missing = "0" }, { key = "b", Index = 2, Missing = "0" },
		{ key = "c", Index = 3, Missing = "0" }, { key = "d", Index = 4, Missing = "1" }, { key = "e", Index = 5 } }
	local rel = { a = true, b = true, d = true, e = true }
	local at = { a = 1000, b = 1250, d = 1000, e = 1000 }
	local cand = purge_candidates(msgs, rel, at, 1300, 300)
	local ids = {}
	for _, m in ipairs(cand) do ids[#ids + 1] = m.Index end
	check("purge: relayed + delay elapsed -> deleted", table.concat(ids, ",") == "1,5")
	check("purge: relayed recently -> kept", not table.concat(ids, ","):match("2"))
	check("purge: not relayed -> kept", not table.concat(ids, ","):match("3"))
	check("purge: incomplete SMS -> kept", not table.concat(ids, ","):match("4"))
	local saved = SEEN_FILE
	SEEN_FILE = os.tmpname()
	save_seen({ "0a1b2c3d", "11112222" }, { ["11112222"] = true })
	local s, o, r = load_seen()
	check("SMS record: \"relayed\" mark read back", s and s["0a1b2c3d"] and r["11112222"] and not r["0a1b2c3d"] and #o == 2)
	local f2 = io.open(SEEN_FILE, "w"); f2:write("deadbeef\n"); f2:close()
	local s2, _, r2 = load_seen()
	check("SMS record: old format (without +) = seen, not purgeable", s2 and s2.deadbeef and not r2.deadbeef)
	os.remove(SEEN_FILE); SEEN_FILE = saved
	-- USSD web page
	check("USSD web: menu answer 6 accepted", valid_ussd_web("6"))
	check("USSD web: 00 accepted", valid_ussd_web("00"))
	check("USSD web: *600# accepted", valid_ussd_web("*600#"))
	check("USSD web: 6;reboot refused", not valid_ussd_web("6;reboot"))
	check("USSD web: empty refused", not valid_ussd_web(""))
	local now = os.time()
	check("USSD session open (recent status 1)", ussd_session_open({ { dir = "out", ts = now }, { dir = "in", status = "1", ts = now - 10 } }))
	check("USSD session closed (status 0)", not ussd_session_open({ { dir = "in", status = "0", ts = now } }))
	check("USSD session expired (> 3 min)", not ussd_session_open({ { dir = "in", status = "1", ts = now - 400 } }))
	local savedh = USSD_HIST
	USSD_HIST = os.tmpname()
	hist_add("out", "", "web", "*600#"); hist_add("in", "1", "web", "1.Balance\n2.Bundles \195\169")
	local h = hist_read()
	check("USSD history: round trip (multi-line, accents)", #h == 2 and h[2].text == "1.Balance\n2.Bundles \195\169" and h[2].status == "1")
	for _ = 1, 45 do hist_add("out", "", "web", "6") end
	check("USSD history: capped at 40 entries", #hist_read() == 40)
	-- Clear session: history erased (dry run: dry-run file present, no call to the modem)
	local savedd = USSD_DRYRUN
	USSD_DRYRUN = USSD_HIST
	cmd_ussd_clear()
	USSD_DRYRUN = savedd
	check("Clear session: USSD history erased", #hist_read() == 0)
	os.remove(USSD_HIST); USSD_HIST = savedh
	-- 32-bit FNV-1a reference vectors
	check("FNV-1a('') = 811c9dc5", fnv1a("") == "811c9dc5")
	check("FNV-1a('a') = e40c292c", fnv1a("a") == "e40c292c")
	check("FNV-1a('foobar') = bf9cf968", fnv1a("foobar") == "bf9cf968")
	print(fails == 0 and "Result: OK" or ("Result: " .. fails .. " failure(s)"))
	return fails == 0 and 0 or 1
end

local cmd = arg[1]
if cmd == "send" then os.exit(cmd_send(arg[2], arg[3]))
elseif cmd == "ussd" then os.exit(cmd_ussd(arg[2]))
elseif cmd == "daemon" then cmd_daemon()
elseif cmd == "sms-list" then os.exit(cmd_sms_list())
elseif cmd == "sms-delete" then os.exit(cmd_sms_delete(arg[2]))
elseif cmd == "ussd-web" then os.exit(cmd_ussd_web(arg[2]))
elseif cmd == "ussd-cancel" then os.exit(cmd_ussd_cancel())
elseif cmd == "ussd-clear" then os.exit(cmd_ussd_clear())
elseif cmd == "ussd-history" then os.exit(cmd_ussd_history())
elseif cmd == "selftest" then os.exit(cmd_selftest())
else
	io.stderr:write("usage: rut360gw-sms send <num> <b64> | daemon | ussd <code> | sms-list | sms-delete <index|all>\n"
		.. "                    | ussd-web <text> | ussd-cancel | ussd-clear | ussd-history | selftest\n")
	os.exit(2)
end
