#!/bin/sh /etc/rc.common
# rut360gw — GSM/VoLTE <-> SIP gateway (Asterisk 18 in RAM + chan_quectel patched for RutOS).
# Configuration: /etc/config/rut360gw (uci). Does not touch USB, the radio or mobile data.

START=99
STOP=10
USE_PROCD=1

ROOT=/tmp/rut360gw/root
ASTCONF=/var/run/rut360gw/etc/asterisk.conf
# RutOS 7.14 installs packages under /usr/local (read-only root); / on the generic test bench
P=; [ -x /usr/local/usr/sbin/rut360gw-config ] && P=/usr/local

start_service() {
	config_load rut360gw
	local enabled sms
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || { logger -t rut360gw "disabled (uci rut360gw.main.enabled=0)"; return 0; }
	# 1. runtime first, extracted to RAM at every router boot: the one from the
	# rut360gw-runtime package, immediately and without network. Otherwise (package missing, archive
	# damaged, not enough RAM), a "runtime" instance prepares it in the background (fallback: download
	# over 4G) and retries every 2 min without limit, then restarts this service: the router boot
	# is never blocked and no manual restart is needed.
	if [ "$($P/usr/sbin/rut360gw-runtime state)" != ready ] && ! $P/usr/sbin/rut360gw-runtime embedded; then
		logger -t rut360gw "runtime not in RAM yet: preparing it in the background, the gateway will start afterwards"
		procd_open_instance runtime
		procd_set_param command $P/usr/sbin/rut360gw-runtime wait
		# no stderr to syslog: rut360gw-runtime already logs through logger (otherwise every line
		# appeared a second time, as "daemon.err")
		procd_set_param stderr 0
		procd_close_instance
		return 0
	fi
	$P/usr/sbin/rut360gw-runtime prepare || { logger -t rut360gw "runtime unavailable"; return 1; }
	$P/usr/sbin/rut360gw-config generate || { logger -t rut360gw "invalid configuration: service not started"; return 1; }
	# LAN rules (SIP limit, anti-spoofing in ip mode): firewall reloaded only if they change
	$P/usr/sbin/rut360gw-fw apply

	# 2. ONLY THEN the RutOS settings the gateway needs (Call Utilities, e-mail forwarding), aligned
	# automatically if main.manage_rutos=1 (default), original values saved; otherwise just a
	# warning. On 7.14 the alignment reloads mobifd, which cuts 4G for ~1-2 min: done before the
	# runtime download, it made the download fail.
	local manage issue
	config_get_bool manage main manage_rutos 1
	[ "$manage" = 1 ] && $P/usr/sbin/rut360gw-rutos align
	$P/usr/sbin/rut360gw-rutos status | while IFS= read -r issue; do
		logger -p user.warn -t rut360gw "WARNING RutOS: $issue (web page > Dashboard, or rut360gw.main.manage_rutos=1)"
	done

	# fingerprint of the generated configuration: procd only restarts an instance if its definition
	# changes; including it guarantees that a new setting (uci commit + reload) restarts Asterisk
	local cfghash
	cfghash=$(cat /var/run/rut360gw/etc/*.conf | md5sum | cut -c1-12)

	procd_open_instance asterisk
	procd_set_param env LD_LIBRARY_PATH="$ROOT/usr/lib:$ROOT/lib" RUT360GW_CONFIG="$cfghash"
	procd_set_param command "$ROOT/usr/sbin/asterisk" -f -C "$ASTCONF"
	# at most 5 restarts per hour, 5 s between attempts
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance

	# driver safety net: restarts Asterisk if the device stays missing, uninitialised
	# or stuck for 5 min (at most 3 times in 6 h), see rut360gw-watchdog
	procd_open_instance watchdog
	procd_set_param command /bin/sh $P/usr/sbin/rut360gw-watchdog
	procd_set_param respawn 3600 10 5
	procd_close_instance

	config_get_bool sms features sms_bridge 1
	if [ "$sms" = 1 ]; then
		# SMS -> SIP bridge (reads received SMS through gsmctl, never opens an AT port)
		procd_open_instance smsbridge
		procd_set_param command /usr/bin/lua $P/usr/sbin/rut360gw-sms daemon
		procd_set_param respawn 3600 10 5
		procd_set_param stderr 1
		procd_close_instance
	fi
}

stop_service() {
	# chan_quectel only resets serial voice to 0 in UAC mode: disable it ourselves
	gsmctl -A 'AT+QPCMV=0,0' >/dev/null 2>&1
}

service_triggers() {
	# `uci commit rut360gw` + `reload_config` (or a save from a RutOS interface)
	# => start_service is evaluated again; if the generated configuration changed, Asterisk restarts.
	# Tip: after a manual change, prefer `/etc/init.d/rut360gw restart`, because
	# reload_config also reloads the other modified RutOS configurations (network: the LAN port
	# may then renegotiate for a few seconds).
	procd_add_reload_trigger rut360gw
}
