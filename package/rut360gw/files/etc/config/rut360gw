# /etc/config/rut360gw — SINGLE configuration file of the RUT360 GSM/VoLTE <-> SIP gateway.
# Change it with `uci set rut360gw.<section>.<option>=<value>` then `rut360gw-config apply`
# (validates, commits and restarts; the Asterisk files are regenerated in RAM). Avoid reload_config:
# on RutOS it also reloads the network (the LAN port renegotiates for a few seconds).
# Secrets (passwords) live here only: file mode 600, never in version control.

config rut360gw 'main'
	# 1 = the service starts (at boot and through /etc/init.d/rut360gw start)
	option enabled '0'
	# call progress tones: fr, dz, or any country of the Asterisk indications.conf
	option country 'fr'
	# 1 = the gateway itself adjusts the RutOS settings it needs (Call Utilities: action
	# removed, otherwise RutOS hangs up incoming calls; e-mail forwarding: delete_sms=0), keeping
	# the original values (/etc/rut360gw/rutos.orig), restored on uninstall. 0 = warning only.
	option manage_rutos '1'

config modem 'modem'
	# expected modem (USB vendor:product); EG06-E of the RUT360 = 2c7c:0306
	option usb_id '2c7c:0306'
	# USB interface number: 1 = NMEA -> serial PCM audio (AT+QPCMV=1,0); 3 = secondary AT
	# (interface 2 = AT port of RutOS gsmd: NEVER use it here)
	option audio_if '1'
	option data_if '3'
	# call tracking by AT+CLCC polling (ms), since the modem URCs belong to gsmd
	option clcc_poll '1000'

config server 'server'
	# remote SIP server (Asterisk, FreePBX...): receives incoming GSM calls, SMS and USSD
	# replies, and can call the mobile network through the gateway. 0 = no server (LAN only)
	option enabled '0'
	# register: the gateway registers with username/password (recommended, works through NAT);
	# ip: trusted peer identified by its address, without password, to be used only behind a
	# VPN (RutOS WireGuard...); the gateway then rejects that address if it comes from the LAN
	option mode 'register'
	# server address (name or IP; in ip mode: its IP inside the VPN) and SIP port (UDP)
	option host ''
	option port '5060'
	# gateway account on the server (register mode)
	option username ''
	option password ''
	# server extension that receives incoming GSM calls, SMS and USSD replies
	option extension ''
	# ip mode only: gateway address inside the VPN (domain of the SMS From header)
	option local_address ''
	option codec 'ulaw'

config sip 'local'
	# LAN SIP client (e.g. Linphone at the office); empty password = disabled. Accepted only from
	# the LAN subnet; the firewall limits LAN SIP to features.lan_sip_limit packets/s
	option username 'rut360'
	option password ''

config features 'features'
	# where incoming GSM calls ring: server (remote SIP server), local (LAN SIP client) or
	# both (both at the same time, the first to answer takes the call); auto = server if it is
	# enabled, otherwise local
	option gsm_in 'auto'
	# firewall: at most N SIP packets per second from the LAN (UDP 5060), the rest is dropped; 0 = no
	# limit. In ip mode, the server address is also rejected if it comes from the LAN (anti-spoofing)
	option lan_sip_limit '20'
	# SMS <-> SIP bridge (RutOS remains the owner of SMS)
	option sms_bridge '1'
	# USSD from Linphone (*code); warning: may cut mobile data for ~45 s (2G/3G fallback)
	option ussd '1'
	# SIM purge: an SMS relayed successfully to Linphone is deleted from the SIM after this delay
	# (seconds), which gives the native RutOS e-mail forwarding (SMS Gateway > SMS Forwarding) time
	# to run. Never purged: SMS present before installation, SMS not relayed, incomplete SMS.
	option sms_purge '1'
	option sms_purge_delay '300'
	# ringback tone of outgoing calls: network (default) = the network's own tone and announcements,
	# like a phone (in VoLTE the network sends none: silence until answered); local = generated by the
	# gateway as soon as the number is dialled (heard in VoLTE too, but without operator announcements)
	option ringback 'network'
	# RTP port range (1 GSM call at a time)
	option rtp_start '10000'
	option rtp_end '10100'
